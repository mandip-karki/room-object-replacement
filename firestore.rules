rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth.token.role;
    }
    function companyId() {
      return request.auth.token.companyId;
    }
    function isSuperAdmin() {
      return request.auth != null && role() == 'super_admin';
    }
    function isClientAdmin() {
      return request.auth != null && role() == 'client_admin';
    }
    function isSameCompany(cid) {
      return request.auth != null && companyId() == cid;
    }

    // companies: only Super Admin manages the tenant list.
    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isSameCompany(companyId);
      allow write: if isSuperAdmin();
    }

    // users: Super Admin sees all; Client Admin manages their own company's users;
    // any signed-in user can read their own profile doc.
    match /users/{userId} {
      allow read: if isSuperAdmin()
        || (request.auth != null && request.auth.uid == userId)
        || (isClientAdmin() && isSameCompany(resource.data.companyId));
      allow create: if isSuperAdmin()
        || (isClientAdmin() && isSameCompany(request.resource.data.companyId)
            && request.resource.data.role == 'sub_account');
      allow update, delete: if isSuperAdmin()
        || (isClientAdmin() && isSameCompany(resource.data.companyId));
    }

    // products: catalog is owned by the Main Company; everyone signed in can read it.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // room_photos: users only see/write their own.
    match /room_photos/{photoId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // replacement_jobs: written only by Cloud Functions (Admin SDK bypasses rules);
    // clients may only read jobs they own or that belong to their own company (admins).
    match /replacement_jobs/{jobId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || ((isClientAdmin() || isSuperAdmin()) && isSameCompany(resource.data.companyId)));
      allow write: if false;
    }
  }
}
